---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "artwork.svenja.dev",
  description = "Artwork by Svenja."
} = Astro.props;

import Navbar from "@repo/ui/Navbar.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cascadia+Mono:wght@400;600;700&family=Gentium+Book+Plus:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navbar currentSection="artwork" currentPath={Astro.url.pathname} />
    <slot />
  </body>
</html>

<style is:global lang="scss">
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    background-color: #16161d;
    color: #e2e2e2;
    min-height: 100vh;
    font-family: "Cascadia Mono", monospace, sans-serif;
  }
</style>
