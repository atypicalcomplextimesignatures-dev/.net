---
import Layout from "../layouts/Layout.astro";

const artworks = [
  {
    id: 1,
    title: "Patchouli's Library Study",
    category: "Character Art",
    year: "2026",
    medium: "Digital / Clip Studio",
    gradient: "linear-gradient(135deg, #2b1f3d 0%, #462c5e 50%, #201a2e 100%)",
    accent: "#b784f5",
  },
  {
    id: 2,
    title: "Nocturne in Scarlet",
    category: "Concept Art",
    year: "2025",
    medium: "Digital Painting",
    gradient: "linear-gradient(135deg, #381a22 0%, #612231 50%, #1f1217 100%)",
    accent: "#ff5e7e",
  },
  {
    id: 3,
    title: "Wind Priestess of Moriya",
    category: "Character Art",
    year: "2025",
    medium: "Vector & Paint",
    gradient: "linear-gradient(135deg, #182e27 0%, #295748 50%, #13211c 100%)",
    accent: "#5ef5c2",
  },
  {
    id: 4,
    title: "Celestial Orrery Breakdown",
    category: "Illustration",
    year: "2025",
    medium: "Mixed Media",
    gradient: "linear-gradient(135deg, #1b283d 0%, #274169 50%, #121926 100%)",
    accent: "#5ebbff",
  },
  {
    id: 5,
    title: "Aya's Wind Journal Cover",
    category: "Design",
    year: "2024",
    medium: "Editorial Layout",
    gradient: "linear-gradient(135deg, #3d2f1f 0%, #6e502b 50%, #241c12 100%)",
    accent: "#ffd47d",
  },
  {
    id: 6,
    title: "Fragments of the Boundary",
    category: "Concept Art",
    year: "2024",
    medium: "Digital Study",
    gradient: "linear-gradient(135deg, #2d1d36 0%, #522766 50%, #1b1221 100%)",
    accent: "#e07dff",
  },
];
---

<Layout title="Artwork — atypicalcomplextimesignatures">
  <header class="section-hero">
    <div class="hero-badge">VISUAL ARCHIVE</div>
    <h1 class="hero-title">Artwork &amp; Illustration</h1>
    <p class="hero-desc">
      Original digital character designs, editorial illustrations, and narrative concept pieces.
    </p>

    <div class="filter-bar">
      <button class="filter-pill active" data-filter="all">All Works</button>
      <button class="filter-pill" data-filter="Character Art">Character Art</button>
      <button class="filter-pill" data-filter="Concept Art">Concept Art</button>
      <button class="filter-pill" data-filter="Illustration">Illustration</button>
      <button class="filter-pill" data-filter="Design">Design</button>
    </div>
  </header>

  <section class="gallery-grid">
    {artworks.map((art) => (
      <article class="gallery-card" data-category={art.category}>
        <div class="card-canvas" style={`background: ${art.gradient}`}>
          <div class="canvas-shimmer"></div>
          <span class="canvas-tag" style={`color: ${art.accent}; border-color: ${art.accent}40`}>
            {art.category}
          </span>
          <div class="canvas-meta-overlay">
            <span class="meta-year">{art.year}</span>
            <span class="meta-medium">{art.medium}</span>
          </div>
        </div>
        <div class="card-info">
          <h2 class="card-title">{art.title}</h2>
          <div class="card-footer">
            <span class="view-prompt">Inspect work &rarr;</span>
          </div>
        </div>
      </article>
    ))}
  </section>
</Layout>

<style lang="scss">
  .section-hero {
    margin-bottom: 3rem;
  }

  .hero-badge {
    display: inline-block;
    font-family: "Cascadia Mono", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.12em;
    padding: 0.35rem 0.75rem;
    background: rgba(255, 212, 125, 0.1);
    border: 1px solid rgba(255, 212, 125, 0.25);
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: "Gentium Book Plus", serif;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 600px;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-card);
    color: var(--text-muted);
    font-family: "Cascadia Mono", monospace;
    font-size: 0.8rem;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-pill:hover,
  .filter-pill.active {
    background: rgba(255, 212, 125, 0.15);
    border-color: rgba(255, 212, 125, 0.4);
    color: var(--accent-gold);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .gallery-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 212, 125, 0.4);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.4);
  }

  .card-canvas {
    height: 240px;
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1rem;
    overflow: hidden;
  }

  .canvas-shimmer {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
  }

  .canvas-tag {
    position: relative;
    font-family: "Cascadia Mono", monospace;
    font-size: 0.72rem;
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    background: rgba(18, 18, 24, 0.85);
    border: 1px solid;
    backdrop-filter: blur(4px);
  }

  .canvas-meta-overlay {
    position: absolute;
    bottom: 0.75rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    font-family: "Cascadia Mono", monospace;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.75);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
  }

  .card-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }

  .card-title {
    font-family: "Gentium Book Plus", serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .view-prompt {
    font-family: "Cascadia Mono", monospace;
    font-size: 0.78rem;
    color: var(--accent-gold);
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .gallery-card:hover .view-prompt {
    opacity: 1;
  }
</style>
