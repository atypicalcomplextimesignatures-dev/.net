---
import Layout from "../layouts/Layout.astro";

const projects = [
  {
    id: "categories-game",
    title: "Categories Puzzle Game",
    status: "Live",
    statusColor: "#48e58a",
    description:
      "Minimalist custom word puzzle engine with four difficulty levels, Google Sheets backend sync, QR share codes, and friend scoreboards.",
    stack: ["Astro", "TypeScript", "Google Apps Script", "PWA"],
    link: "https://games.svenja.dev",
    linkLabel: "Play Game",
  },
  {
    id: "charess-engine",
    title: "Charess Touhou Engine",
    status: "In Development",
    statusColor: "#ffd47d",
    description:
      "Interactive digital character showcase & visual novel preview system featuring Touhou Project lore, animated frames, and dynamic theme switching.",
    stack: ["Astro", "SCSS", "TypeScript", "Vite"],
    link: "/charess",
    linkLabel: "View Demo",
  },
  {
    id: "time-signature-synth",
    title: "Odd Meter Polyrhythm Lab",
    status: "Prototype",
    statusColor: "#4de2f0",
    description:
      "WebAudio visualizer and beat sequencer exploring asymmetrical Balkan time signatures (5/8, 7/8, 11/16) and nested additive rhythms.",
    stack: ["Web Audio API", "Canvas", "TypeScript"],
    link: "#",
    linkLabel: "Launch Lab",
  },
  {
    id: "shared-design-system",
    title: "@repo/ui Design System",
    status: "Internal / Active",
    statusColor: "#c28cfd",
    description:
      "Monorepo design tokens, navigation primitives, and responsive Astro components shared across the atypicalcomplextimesignatures domain network.",
    stack: ["pnpm workspaces", "Astro 5", "CSS Custom Props"],
    link: "https://github.com/atypicalcomplextimesignatures-dev/.net",
    linkLabel: "GitHub Repo",
  },
];
---

<Layout title="Projects — atypicalcomplextimesignatures">
  <header class="section-hero">
    <div class="hero-badge">SOFTWARE &amp; EXPERIMENTS</div>
    <h1 class="hero-title">Projects &amp; Systems</h1>
    <p class="hero-desc">
      Interactive web applications, puzzle mechanics, audio experiments, and open-source tooling.
    </p>

    <div class="stats-bar">
      <div class="stat-item">
        <span class="stat-num">{projects.length}</span>
        <span class="stat-label">Active Projects</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-num">pnpm</span>
        <span class="stat-label">Monorepo Workspace</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-num">Astro 5</span>
        <span class="stat-label">Core Framework</span>
      </div>
    </div>
  </header>

  <section class="projects-grid">
    {projects.map((proj) => (
      <article class="project-card">
        <div class="card-header">
          <span
            class="status-pill"
            style={`color: ${proj.statusColor}; border-color: ${proj.statusColor}40; background: ${proj.statusColor}14`}
          >
            <span class="status-dot" style={`background: ${proj.statusColor}`}></span>
            {proj.status}
          </span>
          <span class="project-id">#{proj.id}</span>
        </div>

        <h2 class="card-title">{proj.title}</h2>
        <p class="card-desc">{proj.description}</p>

        <div class="card-tech">
          {proj.stack.map((tech) => (
            <span class="tech-tag">{tech}</span>
          ))}
        </div>

        <div class="card-footer">
          <a href={proj.link} class="action-btn">
            {proj.linkLabel} &rarr;
          </a>
        </div>
      </article>
    ))}
  </section>
</Layout>

<style lang="scss">
  .section-hero {
    margin-bottom: 3rem;
  }

  .hero-badge {
    display: inline-block;
    font-family: "Cascadia Mono", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.12em;
    padding: 0.35rem 0.75rem;
    background: rgba(255, 212, 125, 0.1);
    border: 1px solid rgba(255, 212, 125, 0.25);
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: "Gentium Book Plus", serif;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 620px;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .stats-bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 10px;
    width: fit-content;
    backdrop-filter: blur(8px);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-num {
    font-family: "Cascadia Mono", monospace;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-gold);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(255, 255, 255, 0.1);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
  }

  .project-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 12px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 212, 125, 0.35);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.4);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: "Cascadia Mono", monospace;
    font-size: 0.72rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid;
    font-weight: 600;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .project-id {
    font-family: "Cascadia Mono", monospace;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.3);
  }

  .card-title {
    font-family: "Gentium Book Plus", serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }

  .tech-tag {
    font-family: "Cascadia Mono", monospace;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .card-footer {
    display: flex;
    justify-content: flex-end;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 1rem;
  }

  .action-btn {
    font-family: "Cascadia Mono", monospace;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-gold);
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .action-btn:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .stats-bar {
      width: 100%;
      justify-content: space-around;
    }
  }
</style>
