---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "games.svenja.dev",
  description = "Games and experiments by Svenja."
} = Astro.props;

import Navbar from "@repo/ui/Navbar.astro";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%2245%22 height=%2245%22 fill=%22%23FF5A24%22/><rect x=%2255%22 width=%2245%22 height=%2245%22 fill=%22%2319F30C%22/><rect y=%2255%22 width=%2245%22 height=%2245%22 fill=%22%2326c9ff%22/><rect x=%2255%22 y=%2255%22 width=%2245%22 height=%2245%22 fill=%22%23e60cf3%22/></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cascadia+Mono:wght@400;600;700&family=Gentium+Book+Plus:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navbar currentSection="games" currentPath={Astro.url.pathname} />
    <slot />
  </body>
</html>

<style is:global lang="scss">
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    background-color: #16161d;
    color: #e2e2e2;
    min-height: 100vh;
    font-family: "Cascadia Mono", monospace, sans-serif;
  }
</style>
