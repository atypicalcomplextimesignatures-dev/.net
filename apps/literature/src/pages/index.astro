---
import Layout from "../layouts/Layout.astro";

const manuscripts = [
  {
    id: 1,
    title: "On the Geometry of Autumn Leaves",
    genre: "Essay / Reflection",
    readTime: "7 min read",
    date: "October 2026",
    excerpt:
      "A wandering investigation into irregular cadences, seasonal decay, and the natural harmonics that govern how we perceive impermanence.",
    tags: ["Aesthetics", "Philosophy", "Observation"],
  },
  {
    id: 2,
    title: "The Archivist of the Red Pavilion",
    genre: "Fiction / Prose",
    readTime: "14 min read",
    date: "August 2026",
    excerpt:
      "Within the subterranean wings of the grand library, books are not merely cataloged by topic, but by the resonance of the room when their pages are turned.",
    tags: ["Fiction", "Touhou Mythos", "Library"],
  },
  {
    id: 3,
    title: "Complex Time Signatures in Folk Composition",
    genre: "Musicology",
    readTime: "11 min read",
    date: "May 2025",
    excerpt:
      "Deconstructing Bulgarian rhythms and asymmetrical pulses: why 7/8, 11/16, and 13/8 feel more like walking than counting.",
    tags: ["Music Theory", "Rhythm", "Folk"],
  },
  {
    id: 4,
    title: "A Night Beneath the Youkai Mountain Sky",
    genre: "Narrative Fiction",
    readTime: "18 min read",
    date: "February 2025",
    excerpt:
      "Cold wind across the cedar ridges, notebooks filled with crow feathers, and an encounter with an eccentric tengu reporter who refuses to tell the straight truth.",
    tags: ["Fiction", "Narrative", "Gensokyo"],
  },
];
---

<Layout title="Literature — atypicalcomplextimesignatures">
  <header class="section-hero">
    <div class="hero-badge">MANUSCRIPTS &amp; PROSE</div>
    <h1 class="hero-title">Literature &amp; Writings</h1>
    <p class="hero-desc">
      Essays on aesthetics, narrative fiction, musicological analysis, and serialized prose.
    </p>

    <div class="filter-bar">
      <button class="filter-pill active">All Writings</button>
      <button class="filter-pill">Essays</button>
      <button class="filter-pill">Fiction</button>
      <button class="filter-pill">Music Theory</button>
    </div>
  </header>

  <section class="manuscripts-list">
    {manuscripts.map((entry) => (
      <article class="manuscript-card">
        <div class="card-meta">
          <span class="genre-tag">{entry.genre}</span>
          <span class="meta-separator">&bull;</span>
          <span class="meta-read">{entry.readTime}</span>
          <span class="meta-separator">&bull;</span>
          <time class="meta-date">{entry.date}</time>
        </div>
        <h2 class="card-title">
          <a href="#">{entry.title}</a>
        </h2>
        <p class="card-excerpt">{entry.excerpt}</p>
        <div class="card-footer">
          <div class="tag-row">
            {entry.tags.map((tag) => (
              <span class="pill-tag">#{tag}</span>
            ))}
          </div>
          <a href="#" class="read-link">Read manuscript &rarr;</a>
        </div>
      </article>
    ))}
  </section>
</Layout>

<style lang="scss">
  .section-hero {
    margin-bottom: 3rem;
  }

  .hero-badge {
    display: inline-block;
    font-family: "Cascadia Mono", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.12em;
    padding: 0.35rem 0.75rem;
    background: rgba(255, 212, 125, 0.1);
    border: 1px solid rgba(255, 212, 125, 0.25);
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: "Gentium Book Plus", serif;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 620px;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-card);
    color: var(--text-muted);
    font-family: "Cascadia Mono", monospace;
    font-size: 0.8rem;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-pill:hover,
  .filter-pill.active {
    background: rgba(255, 212, 125, 0.15);
    border-color: rgba(255, 212, 125, 0.4);
    color: var(--accent-gold);
  }

  .manuscripts-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .manuscript-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 12px;
    padding: 2rem;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .manuscript-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 212, 125, 0.35);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: "Cascadia Mono", monospace;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .genre-tag {
    color: var(--accent-gold);
    font-weight: 600;
  }

  .meta-separator {
    color: rgba(255, 255, 255, 0.2);
  }

  .card-title {
    font-family: "Gentium Book Plus", serif;
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    line-height: 1.25;
  }

  .card-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--accent-gold);
    text-decoration: underline;
  }

  .card-excerpt {
    font-family: "Gentium Book Plus", serif;
    font-size: 1.05rem;
    color: var(--text-prose);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .tag-row {
    display: flex;
    gap: 0.5rem;
  }

  .pill-tag {
    font-family: "Cascadia Mono", monospace;
    font-size: 0.7rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .read-link {
    font-family: "Cascadia Mono", monospace;
    font-size: 0.8rem;
    color: var(--accent-gold);
    text-decoration: none;
    font-weight: 600;
  }

  .read-link:hover {
    text-decoration: underline;
  }
</style>
